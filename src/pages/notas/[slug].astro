---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';

export async function getStaticPaths() {
  const notasDir = join(process.cwd(), 'src/content/notas');
  let paths: any[] = [];

  try {
    const files = await readdir(notasDir);
    const mdFiles = files.filter((f: string) => f.endsWith('.md'));

    for (const file of mdFiles) {
      const content = await readFile(join(notasDir, file), 'utf-8');
      const slug = file.replace('.md', '');
      const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
      if (!frontmatterMatch) continue;

      const fm = frontmatterMatch[1];
      const body = content.replace(/^---\n[\s\S]*?\n---\n*/, '');
      const title = fm.match(/title:\s*"([^"]*)"/)?.[1] || '';
      const tagsMatch = fm.match(/tags:\s*\[([^\]]*)\]/)?.[1] || '';
      const tags = tagsMatch.split(',').map((t: string) => t.trim().replace(/"/g, '')).filter(Boolean);
      const date = fm.match(/date:\s*(\S+)/)?.[1] || '2025-01-01';
      const category = fm.match(/category:\s*"([^"]*)"/)?.[1] || 'Acceso a la informacion';
      const image = fm.match(/image:\s*"([^"]*)"/)?.[1] || '';

      paths.push({
        params: { slug },
        props: { title, tags, date, category, image, body },
      });
    }
  } catch (e) {
    // no notas
  }

  return paths;
}

const { title, tags, date, category, image, body } = Astro.props;

const categoryColors: Record<string, string> = {
  'Acceso a la informacion': 'var(--color-cat-acceso)',
  'Gasto publico': 'var(--color-cat-gasto)',
  'Causa colectiva': 'var(--color-cat-colectiva)',
  'Transparencia': 'var(--color-cat-transparencia)',
};

const catColor = categoryColors[category] || 'var(--color-cat-acceso)';

const formattedDate = new Date(date + 'T12:00:00').toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Markdown to HTML conversion (handles mammoth output conventions)
function markdownToHtml(md: string): string {
  let html = md;

  // 1. Clean up mammoth backslash escapes (e.g. \. \( \) \! \[ \] \- \*)
  html = html.replace(/\\([.()!\[\]\-*_#`~>|{}])/g, '$1');

  // 2. Strip any leftover HTML anchor tags from Google Docs
  html = html.replace(/<a\s+id="[^"]*"><\/a>/g, '');
  html = html.replace(/<a\s+id='[^']*'><\/a>/g, '');

  // 3. Headers
  html = html.replace(/^#### (.+)$/gm, '<h4>$1</h4>');
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');

  // 4. Protect link URLs from inline-formatting regexes
  //    (underscores in filenames like File_Name.pdf must not become <em> tags)
  const urlTokens: { [key: string]: string } = {};
  let tokenIdx = 0;
  html = html.replace(/\]\(([^)]+)\)/g, (_match, url) => {
    const token = `\x00${tokenIdx++}\x00`;
    urlTokens[token] = url;
    return `](${token})`;
  });

  // 5. Bold and italic — both ** and __ conventions (mammoth uses __)
  html = html.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
  html = html.replace(/___(.+?)___/g, '<strong><em>$1</em></strong>');
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/__(.+?)__/g, '<strong>$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  html = html.replace(/_([^_]+)_/g, '<em>$1</em>');

  // 6. Restore link URLs
  for (const [token, url] of Object.entries(urlTokens)) {
    html = html.replace(token, url);
  }

  // 7. Links — PDF links get a special preview button, others are normal links
  html = html.replace(/\[([^\]]+)\]\(([^)]+\.pdf)\)/gi,
    '<button class="doc-preview-btn" data-pdf="$2" data-name="$1"><svg width="14" height="16" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="13" height="15" rx="1.5" stroke="currentColor"/><path d="M3 5h8M3 8h8M3 11h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>$1</button>');
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');

  // 8. Ordered lists (mammoth sometimes generates these)
  html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');

  // 9. Unordered lists
  html = html.replace(/^[-*] (.+)$/gm, '<li>$1</li>');

  // Wrap consecutive <li> in <ul>
  html = html.replace(/(<li>[\s\S]*?<\/li>\n?)+/g, (match) => `<ul>${match}</ul>`);

  // 10. Blockquotes
  html = html.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');

  // 11. Paragraphs — wrap remaining non-block lines
  const lines = html.split('\n');
  let result = '';

  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed) {
      result += '\n';
      continue;
    }
    const isBlock = trimmed.startsWith('<h') ||
      trimmed.startsWith('<ul') ||
      trimmed.startsWith('<ol') ||
      trimmed.startsWith('<blockquote') ||
      trimmed.startsWith('<li') ||
      trimmed.startsWith('<img') ||
      trimmed.startsWith('<div') ||
      trimmed.startsWith('<p');
    if (isBlock) {
      result += trimmed + '\n';
    } else {
      result += `<p>${trimmed}</p>\n`;
    }
  }

  return result;
}

const htmlContent = markdownToHtml(body);
---

<BaseLayout title={title}>
  <article class="nota-article">
    {image && (
      <div class="nota-hero-image">
        <img src={image} alt="" />
      </div>
    )}
    <div class="container nota-container">
      <header class="nota-header">
        <a href="/" class="back-link">Volver a investigaciones</a>
        <span class="nota-category" style={`color: ${catColor}`}>{category}</span>
        <h1 class="nota-title">{title}</h1>
        <div class="nota-meta">
          <div class="nota-tags">
            {tags.map((tag: string) => (
              <span class="nota-tag">{tag}</span>
            ))}
          </div>
          <time class="nota-date" datetime={date}>{formattedDate}</time>
        </div>
      </header>

      <div class="nota-body" set:html={htmlContent} />
    </div>
  </article>

  <!-- PDF Preview Modal -->
  <div id="pdf-modal" class="pdf-modal" aria-modal="true" role="dialog" aria-label="Vista previa del documento" hidden>
    <div class="pdf-modal-backdrop"></div>
    <div class="pdf-modal-container">
      <div class="pdf-modal-header">
        <span class="pdf-modal-title" id="pdf-modal-title"></span>
        <div class="pdf-modal-actions">
          <a class="pdf-modal-download" id="pdf-modal-download" href="" download target="_blank">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Descargar
          </a>
          <button class="pdf-modal-close" id="pdf-modal-close" aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="pdf-modal-body">
        <iframe id="pdf-modal-frame" class="pdf-modal-frame" title="Vista previa del documento"></iframe>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const modal = document.getElementById('pdf-modal') as HTMLElement;
  const frame = document.getElementById('pdf-modal-frame') as HTMLIFrameElement;
  const titleEl = document.getElementById('pdf-modal-title') as HTMLElement;
  const downloadBtn = document.getElementById('pdf-modal-download') as HTMLAnchorElement;
  const closeBtn = document.getElementById('pdf-modal-close') as HTMLButtonElement;
  const backdrop = modal?.querySelector('.pdf-modal-backdrop') as HTMLElement;

  function openModal(pdfUrl: string, name: string) {
    frame.src = pdfUrl;
    titleEl.textContent = name;
    downloadBtn.href = pdfUrl;
    downloadBtn.download = name + '.pdf';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    modal.hidden = true;
    frame.src = 'about:blank';
    document.body.style.overflow = '';
  }

  // Attach click handlers to all PDF preview buttons
  document.querySelectorAll('.doc-preview-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pdfUrl = (btn as HTMLElement).dataset.pdf || '';
      const name = (btn as HTMLElement).dataset.name || 'Documento';
      openModal(pdfUrl, name);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
</script>

<style>
  .nota-article {
    max-width: 100%;
  }

  .nota-hero-image {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    margin-bottom: var(--space-2xl);
  }

  .nota-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nota-container {
    max-width: 760px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link::before {
    content: '\2190\00a0';
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .nota-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border-light);
  }

  .nota-category {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .nota-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: var(--space-lg);
  }

  .nota-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .nota-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .nota-tag {
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--color-bg);
    color: var(--color-text-secondary);
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .nota-date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* Article body styles */
  .nota-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .nota-body :global(p) {
    margin-bottom: 1.25em;
  }

  .nota-body :global(h2) {
    font-size: 1.6rem;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .nota-body :global(h3) {
    font-size: 1.3rem;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .nota-body :global(h4) {
    font-size: 1.1rem;
    margin-top: 1.25em;
    margin-bottom: 0.5em;
  }

  .nota-body :global(strong) {
    font-weight: 600;
  }

  .nota-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .nota-body :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .nota-body :global(ul),
  .nota-body :global(ol) {
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }

  .nota-body :global(li) {
    margin-bottom: 0.4em;
  }

  .nota-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin: 1.5em 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .nota-body :global(img) {
    border-radius: 6px;
    margin: 1.5em 0;
  }

  /* Documentos fuente section */
  .nota-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-light);
    margin: 2.5em 0;
  }

  /* PDF preview buttons */
  .nota-body :global(.doc-preview-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 10px 16px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: left;
    width: 100%;
    margin-bottom: 8px;
  }

  .nota-body :global(.doc-preview-btn:hover) {
    background: white;
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateX(3px);
  }

  .nota-body :global(.doc-preview-btn svg) {
    flex-shrink: 0;
    opacity: 0.5;
  }

  /* PDF Modal */
  .pdf-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .pdf-modal[hidden] {
    display: none;
  }

  .pdf-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(3px);
  }

  .pdf-modal-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 920px;
    height: 88vh;
    background: white;
    border-radius: 10px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .pdf-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border-light);
    background: var(--color-bg);
    flex-shrink: 0;
    gap: var(--space-md);
  }

  .pdf-modal-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .pdf-modal-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .pdf-modal-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    transition: all var(--transition-fast);
    background: white;
  }

  .pdf-modal-download:hover {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .pdf-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .pdf-modal-close:hover {
    background: var(--color-text);
    color: white;
    border-color: var(--color-text);
  }

  .pdf-modal-body {
    flex: 1;
    overflow: hidden;
    background: #525659;
  }

  .pdf-modal-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .nota-title {
      font-size: 1.75rem;
    }

    .nota-body {
      font-size: 1rem;
    }

    .pdf-modal {
      padding: 0;
      align-items: flex-end;
    }

    .pdf-modal-container {
      max-width: 100%;
      height: 92vh;
      border-radius: 14px 14px 0 0;
    }
  }
</style>
